{
  // VS Code's built-in CSS language server predates Tailwind v4 and reports
  // its at-rules (@theme, @apply, @custom-variant, @plugin) as "Unknown at
  // rule". They're valid — Tailwind processes them at build time — so the
  // warnings are noise rather than real problems.
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
